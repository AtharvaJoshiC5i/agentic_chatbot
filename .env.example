# Application
APP_ENV=development
APP_NAME=ShopSphere AI Returns Agent
LOG_LEVEL=INFO

# SQLite (path resolved relative to backend/ when using default file URL)
DATABASE_URL=sqlite:///./shopsphere.db

# ChromaDB persistent storage (resolved relative to project root)
CHROMA_PATH=./chroma_data

# CORS (comma-separated origins for the React app in later phases)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LLM router default (chat may override per request / UI)
LLM_PROVIDER=groq

# Groq (OpenAI-compatible API)
GROQ_API_KEY=
# Extra keys to raise throughput (comma / semicolon / newline separated). Primary GROQ_API_KEY is always used when set.
GROQ_API_KEYS=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.3-70b-versatile
# Per-key client RPM cap; effective budget is GROQ_MAX_RPM × number of keys.
GROQ_MAX_RPM=30

# Context window (approximate tokens; output reserve is subtracted from input cap per LLM call)
LLM_CONTEXT_INPUT_TOKENS=28000
LLM_CONTEXT_OUTPUT_RESERVE=4096
LLM_HISTORY_MAX_TOKENS=3500
LLM_TOOL_MESSAGE_MAX_TOKENS=700

# Google Gemini (default model gemini-3.5-flash-lite; override with GEMINI_MODEL; 14 RPM client cap)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_RPM=14

# Legacy aliases (optional): LLM_API_KEY, LLM_MODEL, LLM_BASE_URL, GOOGLE_API_KEY

# Embeddings (Phase 5+)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Auth (Phase 6)
JWT_SECRET_KEY=change-me-in-production-use-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Action gateway (spec P40 / approval TTL)
ACTIONS_DISABLED=false
ACTION_APPROVAL_EXPIRE_HOURS=72
MONITORING_AUTO_RUN=false
MONITORING_INTERVAL_MINUTES=30
